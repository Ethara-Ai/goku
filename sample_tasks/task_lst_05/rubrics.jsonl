{"number": 3, "type": "shell_succeeds_real", "category": "MM_REASONING", "points": 5, "importance": "mandatory", "subjective": false, "criterion": "rickshaw_index.json contains all required categories with the correct image lists and counts, 11 sketches, 16 duplicates, 10 clear_plate, 25 ev_rickshaw, 16 gas_rickshaw, 13 manual_rickshaw and 10 others.", "raw_shell": "python3 - <<'PY'\nimport json, os\nassert os.path.isdir('auto_result')\nwith open('auto_result/rickshaw_index.json') as f:\n    d=json.load(f)\nexp={\n'sketches':['i2.jpeg','i3.jpeg','i6.jpeg','i13.jpeg','i20.jpeg','i33.jpeg','i37.jpeg','i48.jpeg','i56.jpeg','i91.jpeg','i101.jpeg'],\n'duplicates':['i1.jpeg','i14.jpeg','i5.jpeg','i27.jpeg','i45.jpeg','i57.jpeg','i64.jpeg','i7.jpeg','i63.jpeg','i88.jpeg','i9.jpeg','i23.jpeg','i68.jpeg','i96.jpeg','i71.jpeg','i75.jpeg'],\n'clear_plate':['i15.jpeg','i17.jpeg','i26.jpeg','i28.jpeg','i30.jpeg','i34.jpeg','i38.jpeg','i66.jpeg','i79.jpeg','i89.jpeg'],\n'ev_rickshaw':['i10.jpeg','i11.jpeg','i18.jpeg','i19.jpeg','i21.jpeg','i24.jpeg','i25.jpeg','i29.jpeg','i31.jpeg','i32.jpeg','i43.jpeg','i50.jpeg','i52.jpeg','i53.jpeg','i59.jpeg','i60.jpeg','i61.jpeg','i72.jpeg','i73.jpeg','i76.jpeg','i82.jpeg','i83.jpeg','i84.jpeg','i87.jpeg','i97.jpeg'],\n'gas_rickshaw':['i8.jpeg','i16.jpeg','i40.jpeg','i41.jpeg','i51.jpeg','i55.jpeg','i62.jpeg','i67.jpeg','i69.jpeg','i74.jpeg','i81.jpeg','i85.jpeg','i90.jpeg','i93.jpeg','i95.jpeg','i100.jpeg'],\n'manual_rickshaw':['i12.jpeg','i22.jpeg','i39.jpeg','i42.jpeg','i44.jpeg','i46.jpeg','i49.jpeg','i54.jpeg','i70.jpeg','i80.jpeg','i86.jpeg','i92.jpeg','i94.jpeg'],\n'others':['i4.jpeg','i35.jpeg','i36.jpeg','i47.jpeg','i58.jpeg','i65.jpeg','i77.jpeg','i78.jpeg','i98.jpeg','i99.jpeg']\n}\nassert set(d.keys())==set(exp.keys())\nfor k,v in exp.items():\n    assert d[k]['count']==len(v)\n    assert sorted(d[k]['images'])==sorted(v)\nPY"}
